[Unit]
Description=InSite CSI Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/insite/server
ExecStart=/opt/insite/server/venv/bin/python3 csi_server.py --positions /opt/insite/config/node_positions.json
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
